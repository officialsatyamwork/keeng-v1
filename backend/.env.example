# Copy to .env and fill in. Never commit the real .env.
# development | staging | production
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://salon:salon@localhost:5432/salon

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production-please-32-chars-min
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Refresh token cookie. Must be true when served over HTTPS (production).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# console = print emails to the log; smtp = send for real
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Keeng <no-reply@yourdomain.com>

# Master admin bootstrap (python -m app.scripts.bootstrap_master)
MASTER_ADMIN_EMAIL=owner@keeng.app
MASTER_ADMIN_PASSWORD=Keeng@123
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_PHONE=9876500000
MASTER_ADMIN_BUSINESS_NAME=Keeng Salon
